# ── Sanity CMS ──────────────────────────────────────────────
# Lấy tại: sanity.io/manage → chọn project → Project ID
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
# Settings → API → Tokens → Add token (Editor role)
SANITY_API_TOKEN=your_sanity_api_token

# ── Threads API (Phase 4) ────────────────────────────────────
THREADS_APP_ID=your_app_id
THREADS_APP_SECRET=your_app_secret
THREADS_ACCESS_TOKEN_QUEENLAM=your_token
THREADS_USER_ID_QUEENLAM=your_user_id
THREADS_ACCESS_TOKEN_FINDING20S=your_token
THREADS_USER_ID_FINDING20S=your_user_id
