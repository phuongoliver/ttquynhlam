# Site URL (set to your Vercel deploy URL)
NEXT_PUBLIC_SITE_URL=https://quynhlam.vercel.app

# Threads API (Phase 4 — Threads Sync)
THREADS_APP_ID=your_app_id
THREADS_APP_SECRET=your_app_secret
THREADS_ACCESS_TOKEN=your_long_lived_token
THREADS_USER_ID=your_threads_user_id

# Admin dashboard password — truy cập /admin
# Nếu không set, trang /admin cho vào tự do (chỉ dùng local)
NEXT_PUBLIC_ADMIN_SECRET=your_simple_password
